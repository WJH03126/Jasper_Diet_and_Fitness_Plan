page {
  --primary-color: #10B981;
  --primary-light: #D1FAE5;
  --primary-dark: #059669;
  --secondary-color: #3B82F6;
  --warning-color: #F59E0B;
  --danger-color: #EF4444;
  --bg-color: #F5F7FA;
  --card-bg: #FFFFFF;
  --text-primary: #1F2937;
  --text-secondary: #6B7280;
  --text-muted: #9CA3AF;
  --border-color: #E5E7EB;
  --success-color: #10B981;
  --gradient-primary: linear-gradient(135deg, #10B981 0%, #059669 100%);
  background-color: var(--bg-color);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text {
  box-sizing: border-box;
}

.page-container {
  padding: 24rpx;
  min-height: 100vh;
}

.card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.card-title .title-icon {
  width: 8rpx;
  height: 32rpx;
  background: var(--primary-color);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.btn-primary {
  background: var(--gradient-primary);
  color: #FFFFFF;
  border-radius: 50rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0 48rpx;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #FFFFFF;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 50rpx;
  height: 88rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  background: #FFFFFF;
  color: var(--danger-color);
  border: 2rpx solid var(--danger-color);
  border-radius: 50rpx;
  height: 72rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  text-align: center;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-success {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.tag-warning {
  background: #FEF3C7;
  color: #92400E;
}

.tag-danger {
  background: #FEE2E2;
  color: #991B1B;
}

.tag-info {
  background: #DBEAFE;
  color: #1E40AF;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #E5E7EB;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-fill.success {
  background: var(--primary-color);
}

.progress-fill.warning {
  background: var(--warning-color);
}

.progress-fill.danger {
  background: var(--danger-color);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-muted);
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
}

.divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-muted {
  color: var(--text-muted);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-danger {
  color: var(--danger-color);
}

.text-primary-color {
  color: var(--primary-color);
}

.font-bold {
  font-weight: 600;
}

.font-normal {
  font-weight: 400;
}

.font-large {
  font-size: 36rpx;
}

.font-small {
  font-size: 24rpx;
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }

.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  text-align: right;
}

.form-picker {
  flex: 1;
  text-align: right;
  color: var(--text-primary);
  font-size: 28rpx;
}

.dark-mode-adapt {
  background-color: var(--card-bg);
}

@media (prefers-color-scheme: dark) {
  page {
    --bg-color: #111827;
    --card-bg: #1F2937;
    --text-primary: #F9FAFB;
    --text-secondary: #D1D5DB;
    --text-muted: #9CA3AF;
    --border-color: #374151;
  }
}
