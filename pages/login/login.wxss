.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #D1FAE5 0%, #FFFFFF 50%, #F5F7FA 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  background: var(--gradient-primary);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(16, 185, 129, 0.3);
}

.app-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.app-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.login-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: var(--gradient-primary);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.35);
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background: #D1D5DB;
  box-shadow: none;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.login-tip {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}

.link {
  color: var(--primary-color);
}
