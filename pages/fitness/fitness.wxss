/* ============ Banner ============ */
.fit-banner {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  color: #fff;
}

.fit-banner .banner-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #10B981 0%, #059669 60%, #047857 100%);
  z-index: 0;
}

.fit-banner .banner-bg::after {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.fit-banner .banner-bg::before {
  content: '';
  position: absolute;
  bottom: -120rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.banner-content {
  position: relative;
  z-index: 1;
}

.banner-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.banner-greet {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  max-width: 380rpx;
}

.banner-date {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
}

.date-num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
}

.date-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.date-ym {
  font-size: 22rpx;
  opacity: 0.85;
}

.date-week {
  font-size: 22rpx;
  font-weight: 500;
}

.banner-streak {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.banner-streak-empty {
  background: rgba(255, 255, 255, 0.1);
}

.streak-flame {
  font-size: 32rpx;
}

.streak-text {
  opacity: 0.95;
}

.streak-num {
  font-size: 30rpx;
  font-weight: 700;
  margin: 0 4rpx;
}

/* ============ 快捷入口 ============ */
.fit-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.fa-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx 24rpx;
  background: var(--card-bg);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.fa-item:active {
  transform: scale(0.96);
}

.fa-ic {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.fa-ic-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  opacity: 0.15;
}

.fa-green .fa-ic-ring {
  background: linear-gradient(135deg, #10B981, #059669);
}

.fa-blue .fa-ic-ring {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
}

.fa-orange .fa-ic-ring {
  background: linear-gradient(135deg, #F59E0B, #D97706);
}

.fa-green .fa-ic-ring { opacity: 0.2; }
.fa-blue .fa-ic-ring { opacity: 0.2; }
.fa-orange .fa-ic-ring { opacity: 0.2; }

.fa-emoji {
  font-size: 44rpx;
}

.fa-txt {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

/* ============ 本周统计 ============ */
.fit-stats {
  padding: 28rpx 20rpx;
}

.fs-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 12rpx;
}

.fs-divider {
  width: 2rpx;
  height: 80rpx;
  background: var(--border-color);
}

.fs-ic {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.fs-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.fs-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--text-primary);
}

.fs-lbl {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.fs-bar {
  width: 100%;
  max-width: 140rpx;
  height: 8rpx;
  background: #F3F4F6;
  border-radius: 4rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.fs-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.fs-fill-green { background: linear-gradient(90deg, #10B981, #059669); }
.fs-fill-orange { background: linear-gradient(90deg, #F59E0B, #D97706); }
.fs-fill-blue { background: linear-gradient(90deg, #3B82F6, #2563EB); }

/* ============ 体重记录 ============ */
.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
