}

.title-icon {
  width: 8rpx;
  height: 30rpx;
  background: var(--gradient-primary);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.weight-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.we-emoji {
  font-size: 72rpx;
  margin-bottom: 12rpx;
  opacity: 0.5;
}

.we-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.we-hint {
  font-size: 24rpx;
  color: var(--text-muted);
}

.weight-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.wm-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.wm-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.wm-unit {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

.wm-date {
  font-size: 24rpx;
  color: var(--text-muted);
}

.wm-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.wr-spark {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 64rpx;
}

.wr-bar {
  width: 12rpx;
  min-height: 8rpx;
  background: linear-gradient(180deg, #10B981, #059669);
  border-radius: 6rpx;
  opacity: 0.85;
}

.wr-tip {
  font-size: 22rpx;
  color: var(--text-muted);
}

