.user-header {
  background: var(--gradient-primary);
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.25);
}

.avatar-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-default {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-nickname {
  font-size: 24rpx;
  font-weight: normal;
  opacity: 0.85;
}

.user-meta {
  font-size: 24rpx;
  opacity: 0.9;
}

.user-meta .dot {
  margin: 0 10rpx;
  opacity: 0.55;
}

.edit-btn {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(6px);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.target-card {
  padding: 28rpx 32rpx 24rpx;
}

.target-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.target-title-wrap {
  display: flex;
  align-items: center;
}

.target-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.title-icon {
  width: 8rpx;
  height: 28rpx;
  background: var(--primary-color);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.refresh-btn {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  color: var(--primary-dark);
  font-size: 24rpx;
}

.refresh-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
  font-weight: 700;
  line-height: 1;
}

.refresh-text {
  font-size: 22rpx;
  font-weight: 500;
}

.target-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.target-item {
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
}

.target-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.target-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.target-unit {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.menu-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: var(--primary-light);
}

.menu-icon.bell-ic {
  background: #FEF3C7;
}

.menu-icon.info-ic {
  background: #DBEAFE;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  color: var(--text-muted);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.menu-divider {
  height: 2rpx;
  background: var(--border-color);
}

.logout-btn {
  margin-top: 56rpx;
  text-align: center;
  color: var(--danger-color);
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  background: transparent;
  border: none;
}

.logout-btn::after {
  border: none;
}

.avatar-wrap {
  position: relative;
}

.guest-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #FEF3C7;
  color: #92400E;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  border: 2rpx solid #F59E0B;
  white-space: nowrap;
}

.guest-logout {
  color: var(--warning-color);
}

.upgrade-btn {
  margin-top: 48rpx;
  background: var(--gradient-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(16, 185, 129, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.upgrade-btn::after {
  border: none;
}

.upgrade-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}
