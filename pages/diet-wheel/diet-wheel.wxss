.page-container {
  padding: 24rpx;
  padding-bottom: 200rpx;
  background: #F8FAFB;
  min-height: 100vh;
}

.meal-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.meal-tab {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.25s;
}

.meal-tab.active {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 8rpx 24rpx rgba(16,185,129,0.3);
  transform: translateY(-2rpx);
}

.meal-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.meal-name {
  font-size: 26rpx;
  color: #9CA3AF;
}

.meal-tab.active .meal-name {
  color: #FFFFFF;
  font-weight: 600;
}

.wheel-wrap {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 24rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
  margin-bottom: 32rpx;
}

.wheel-container {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin: 0 auto 40rpx;
}

.wheel-outer {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  padding: 14rpx;
  background: linear-gradient(135deg, #10B981, #3B82F6, #F59E0B, #EF4444, #8B5CF6, #EC4899);
  box-shadow:
    0 16rpx 48rpx rgba(0,0,0,0.18),
    0 4rpx 16rpx rgba(0,0,0,0.08),
    inset 0 2rpx 4rpx rgba(255,255,255,0.3);
}

.wheel {
  position: absolute;
  inset: 14rpx;
  border-radius: 50%;
  transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99);
  overflow: hidden;
}

.sector-pos {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-origin: center center;
  transform: rotate(calc(var(--idx) * 360deg / var(--total) + 180deg / var(--total)));
  pointer-events: none;
}

.sector-text {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 150rpx;
  text-align: center;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.7);
  transform: translate(-50%, -50%) translateY(-195rpx) rotate(calc(var(--idx) * -360deg / var(--total) - 180deg / var(--total)));
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.wheel-pointer {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 24rpx solid transparent;
  border-right: 24rpx solid transparent;
  border-top: 40rpx solid #EF4444;
  z-index: 10;
  filter: drop-shadow(0 6rpx 10rpx rgba(239,68,68,0.6));
}

.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 220rpx;
  height: 220rpx;
  background: #FFFFFF;
  border-radius: 50%;
  z-index: 5;
  box-shadow:
    0 8rpx 32rpx rgba(0,0,0,0.3),
    inset 0 2rpx 4rpx rgba(255,255,255,1),
    inset 0 -4rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #F3F4F6;
}

.center-result {
  text-align: center;
  padding: 0 16rpx;
}

.cr-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #059669;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-sub {
  font-size: 20rpx;
  color: #6B7280;
}

.center-hint {
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
}

.hint-emoji {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}

.spin-btn-wrap {
  padding: 0 32rpx;
}

.spin-btn {
  text-align: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 32rpx rgba(16,185,129,0.35);
}

.spin-btn.disabled {
  opacity: 0.7;
}

.spin-btn.empty {
  background: #F3F4F6;
  color: #9CA3AF;
  box-shadow: none;
  font-size: 28rpx;
  font-weight: 500;
}

.pool-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.pool-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pool-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.pool-count {
  color: #10B981;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 4rpx;
}

.pool-head-btns {
  display: flex;
  gap: 12rpx;
}

.ph-btn {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.ph-btn.primary {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
}

.ph-btn.ghost {
  background: #F3F4F6;
  color: #6B7280;
}

.pool-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pool-chip {
  display: flex;
  align-items: center;
  background: #ECFDF5;
  color: #065F46;
  padding: 10rpx 8rpx 10rpx 20rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.chip-name {
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-x {
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: 400;
  opacity: 0.5;
  padding: 0 12rpx;
}

.pool-empty {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 24rpx 0;
}

.history-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.clear-btn {
  font-size: 24rpx;
  color: #EF4444;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.history-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

.h-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10B981;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.h-name {
  flex: 1;
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
}

.h-weight {
  font-size: 24rpx;
  color: #9CA3AF;
}

.confirm-btn {
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(16,185,129,0.3);
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.modal-box {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  pointer-events: auto;
  position: relative;
  z-index: 201;
}

.modal-box.small {
  max-height: 70vh;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  font-size: 44rpx;
  color: #9CA3AF;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-toolbar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
}

.modal-search {
  flex: 1;
  background: #F3F4F6;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}

.custom-entry {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.modal-scroll {
  flex: 1;
  max-height: 60vh;
  padding-bottom: 16rpx;
}

.empty-hint {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 48rpx 0;
}

.food-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #F9FAFB;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.fi-left {
  flex: 1;
  min-width: 0;
}

.fi-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.fi-tag {
  display: inline-block;
  font-size: 18rpx;
  background: #F59E0B;
  color: #FFFFFF;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.fi-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}

.fi-action {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item.half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 10rpx;
}

.form-input {
  background: #F3F4F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1F2937;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-bottom: 16rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
}

.add-modal-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 16rpx;
}

.amb-left {
  font-size: 24rpx;
  color: #9CA3AF;
}

.amb-btn {
  font-size: 24rpx;
  color: #10B981;
  padding: 6rpx 20rpx;
  border: 1rpx solid #10B981;
  border-radius: 24rpx;
}

.amb-btn.active {
  background: #10B981;
  color: #FFFFFF;
}

.add-modal-manage-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #FEF3C7;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.amm-info {
  flex: 1;
  color: #92400E;
}

.amm-action {
  color: #F59E0B;
  padding: 4rpx 12rpx;
}

.amm-action.danger {
  color: #EF4444;
  font-weight: 600;
}

.amm-action.danger.disabled {
  color: #B0B0B0;
  pointer-events: none;
}

.food-item.manage {
  padding-left: 8rpx;
}

.fm-check {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #C8C8C8;
  border-radius: 50%;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
  background: #fff;
}

.fm-check.checked {
  background: #EF4444;
  border-color: #EF4444;
}

.modal-tip {
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: center;
  padding: 16rpx 0 4rpx;
}

.pool-edit-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #ECFDF5;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.peb-info {
  flex: 1;
  color: #059669;
}

.peb-action {
  color: #10B981;
  padding: 4rpx 12rpx;
}

.peb-action.danger {
  color: #EF4444;
  font-weight: 600;
}

.peb-action.danger.disabled {
  color: #B0B0B0;
  pointer-events: none;
}

.pool-chip.edit {
  padding-left: 8rpx;
}

.pool-chip.selected {
  background: #D1FAE5;
  border: 2rpx solid #10B981;
}

.chip-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #C8C8C8;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  background: #fff;
}

.chip-check.checked {
  background: #10B981;
  border-color: #10B981;
}

.chip-custom-tag {
  display: inline-block;
  font-size: 18rpx;
  background: #F59E0B;
  color: #FFFFFF;
  padding: 0 8rpx;
  border-radius: 8rpx;
  margin-left: 6rpx;
  font-weight: 500;
}
