.header {
  padding: 16rpx 8rpx 20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 20rpx;
}

.search-input {
  background: #F3F4F6;
  border-radius: 36rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  color: #374151;
}

.filter-tabs {
  margin-bottom: 16rpx;
}

.part-scroll {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.part-tab {
  padding: 12rpx 28rpx;
  background: #F3F4F6;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.part-tab.active {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.type-filters {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.type-filter-item {
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  background: #F9FAFB;
  font-size: 24rpx;
  color: #9CA3AF;
  border: 1rpx solid #E5E7EB;
}

.type-filter-item.active {
  background: #D1FAE5;
  color: #065F46;
  border-color: #10B981;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

.equip-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 140rpx;
}

.equip-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.eq-top {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.eq-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.eq-info {
  flex: 1;
  min-width: 0;
}

.eq-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.eq-sub {
  display: flex;
  gap: 12rpx;
}

.eq-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.eq-type {
  background: #EFF6FF;
  color: #1D4ED8;
}

.eq-part {
  background: #FEF3C7;
  color: #92400E;
}

.eq-actions {
  display: flex;
  gap: 16rpx;
}

.eq-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.eq-primary {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
}

.eq-ghost {
  background: #F3F4F6;
  color: #374151;
}

.eq-selected {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(16,185,129,0.3);
}

.equip-card.selected {
  border: 3rpx solid #10B981;
  background: linear-gradient(180deg, #F0FDF4 0%, #FFFFFF 40%);
  box-shadow: 0 6rpx 20rpx rgba(16,185,129,0.12);
}

.eq-check-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 8rpx;
  box-shadow: 0 4rpx 10rpx rgba(16,185,129,0.3);
}

.selected-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 32rpx rgba(16,185,129,0.3);
  z-index: 100;
}

.sel-count {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.sel-arrow {
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.modal-box {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 80vh;
}

.modal-lg {
  max-height: 85vh;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 24rpx;
}

.modal-section {
  margin-bottom: 20rpx;
}

.modal-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 6rpx;
}

.modal-val {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.modal-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
}

.modal-input {
  background: #F3F4F6;
  border-radius: 28rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
}

.exercise-list {
  max-height: 500rpx;
}

.exercise-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.ex-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  color: #1D4ED8;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ex-main {
  flex: 1;
}

.ex-name {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.ex-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.modal-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
}

.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #FFF7ED;
  border-radius: 14rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #FED7AA;
}

.batch-info {
  font-size: 24rpx;
  color: #9A3412;
  font-weight: 500;
}

.batch-actions {
  display: flex;
  gap: 16rpx;
}

.ba-btn {
  padding: 10rpx 22rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(16,185,129,0.3);
}

.ba-btn.clear {
  background: #FEE2E2;
  color: #B91C1C;
  box-shadow: none;
}

.rf-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 24rpx;
}

.rf-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.rf-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.rf-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rf-input {
  flex: 1;
  background: #F3F4F6;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  color: #1F2937;
  text-align: center;
}

.rf-unit {
  font-size: 26rpx;
  color: #9CA3AF;
}

.rf-tip {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #92400E;
  font-weight: 500;
}
